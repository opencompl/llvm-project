r2d2.trace "test.mlir" (%p0) {
  %0  = r2d2.loc [%p0:1:18] ()
  %1  = r2d2.loc [%p0:2:8]  ()
  %2  = r2d2.loc [%p0:3:8]  ()
  %3  = r2d2.loc [%p0:4:3]  ()
  %4  = r2d2.loc [%p0:1:1]  ()
  %5  = r2d2.loc [%p0:0:0]  ()
  %p1 = r2d2.pass "snap-pass1.mlir" (%p0)
  %6  = r2d2.loc [%p1:4:4] (%1, %2)
  %7  = r2d2.loc [%p1:5:4] (%3)
  %8  = r2d2.loc [%p1:3:2] (%4)
  %9  = r2d2.loc [%p1:2:0] (%5)
  %p2 = r2d2.pass "snap-pass2.mlir" (%p1)
  %10 = r2d2.loc [%p2:4:4] (%6)
  %11 = r2d2.loc [%p2:5:4] (%7)
  %12 = r2d2.loc [%p2:3:2] (%8)
  %13 = r2d2.loc [%p2:2:0] (%9)
}
